{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["src/*"],
      "components/*": ["src/components/*"],
      "context/*": ["src/context/*"],
      "pages/*": ["src/pages/*"],
      "services/*": ["src/services/*"],
      "utils/*": ["src/utils/*"]
    }
  },
  "include": ["src"]
}
